{
    "_comment" : "Simple Packer Template using Ubuntu 20.04",
    "variables": {
      "aws_access_key": "",
      "aws_secret_key": ""
    },
    "builders": [{
      "type": "amazon-ebs",
      "access_key": "{{user `aws_access_key`}}",
      "secret_key": "{{user `aws_secret_key`}}",
      "region": "us-west-2",
      "source_ami": "ami-0cb4e786f15603b0d",
      "instance_type": "t2.micro",
      "ssh_username": "ubuntu",
      "ami_name": "bastion-ami-{{isotime | clean_resource_name}}"
    }],
      "provisioners": [
          {
              "type": "shell",
              "inline": [
                  "sleep 30",
                  "sudo apt-get update",
                  "sudo apt-get install -y build-essential software-properties-common python-dev",
                  "sudo apt-add-repository ppa:ansible/ansible",
                  "sudo apt-get update",
                  "sudo apt-get install -y ansible"
              ]
          },
          {
              "type": "ansible-local",
              "playbook_file": "ami/setup.yaml"
          }
      ]
  }